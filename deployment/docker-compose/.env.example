POSTGRES_DATA_PATH=./tmp/data/postgres/data
POSTGRES_BACKUP_PATH=./tmp/data/postgres/backups
REDIS_DATA_PATH=./tmp/data/redis/data
FLUENTD_LOG_PATH=./tmp/logs/fluentd
FLUENTD_CUSTOM_CONFIG_PATH=./tmp/config
FLUENTD_DOCKER_CONTAINERS_PATH=/var/lib/docker/containers
# Compose project whose logs fluentd collects (the `name` in docker-compose.yml, or `-p`).
#FLUENTD_COMPOSE_PROJECT=eventcally-ical-importer

POSTGRES_USER=eventcally
POSTGRES_PASSWORD=
POSTGRES_DB=eventcally
POSTGRES_PORT=5432
REDIS_PASSWORD=

WEB_TAG=latest
WEB_PORT=5000
SERVER_NAME=ical-importer.eventcally.com
SECRET_KEY=

EVENTCALLY_URL=https://eventcally.com
EVENTCALLY_SITE_NAME=EventCally
EVENTCALLY_CLIENT_ID=
EVENTCALLY_CLIENT_SECRET=
EVENTCALLY_PRIVATE_KEY=
EVENTCALLY_KID=
EVENTCALLY_APP_ID=

# One JSON object per log line (json, for fluentd) or readable lines (console).
#LOG_FORMAT=json
# Keep INFO in production: DEBUG writes the EventCally API requests and responses.
#LOG_LEVEL=INFO
