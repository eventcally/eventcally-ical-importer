# Tail docker logs
<source>
  @type tail
  @label @DOCKER
  read_from_head true
  path /fluentd/containers/*/*-json.log
  pos_file /fluentd/log/docker.pos
  time_format %Y-%m-%dT%H:%M:%S
  tag docker.*
  format json
</source>

<label @DOCKER>
  # The tail reads all containers of the host: keep only this compose project's lines
  # (docker adds the project label as "attrs", see x-logging in docker-compose.yml)
  <filter docker.**>
    @type grep
    <regexp>
      key $['attrs']['com.docker.compose.project']
      pattern "/^#{ENV['FLUENTD_COMPOSE_PROJECT'] || 'eventcally-ical-importer'}$/"
    </regexp>
  </filter>

  # Add container id, drop the label again
  <filter docker.fluentd.containers.*.*.log>
    @type record_transformer
    remove_keys attrs
    <record>
      container_id ${tag_parts[3]}
    </record>
  </filter>

  # JSON lines (app, gunicorn and Celery with LOG_FORMAT=json) become fields; other lines
  # (PostgreSQL, Redis, LOG_FORMAT=console) keep their raw "log" field.
  <filter docker.**>
    @type parser
    key_name log
    reserve_data true
    # keep docker's time of the line
    reserve_time true
    remove_key_name_field true
    emit_invalid_record_to_error false
    <parse>
      @type json
    </parse>
  </filter>

  <match docker.**>
    @type relabel
    @label @ERRORS
  </match>
</label>

<label @ERRORS>
  # Errors and worse. JSON lines by their level. Raw lines by their text:
  # [ERROR]/[CRITICAL] (LOG_FORMAT=console), PostgreSQL FATAL:/PANIC:.
  <filter docker.**>
    @type grep
    <or>
      <regexp>
        key level
        pattern /^(error|critical)$/i
      </regexp>
      <regexp>
        key log
        pattern /\[(error|critical|crit|alert|emerg)\]|\| error \||\b(fatal|panic):/i
      </regexp>
    </or>
  </filter>

  <match docker.**>
    @type copy

    # Write errors to file
    <store>
      @type file
      path /fluentd/log/docker-error
    </store>

    # Count daily errors
    <store>
      @type relabel
      @label @ERROR_COUNT
    </store>
  </match>
</label>

<label @ERROR_COUNT>
  # The count's message: the raw line, else the JSON line's event
  <filter docker.**>
    @type record_transformer
    enable_ruby true
    <record>
      message ${record["log"] || record["event"]}
    </record>
  </filter>

  <match docker.**>
    @type grepcounter
    count_interval 86400 # = 24 hours
    input_key message
    threshold 1
    add_tag_prefix daily_error
    delimiter \n
  </match>

  # Send daily error mail (grepcounter emits inside this label)
  #<match daily_error.docker.**>
  #  @type mail
  #  host [Host]
  #  port [Port]
  #  user [User/Email]
  #  password [Password]
  #  from [User/Email]
  #  to [Recipient]
  #  subject 'Error alert fluentd'
  #  message Error occured %s times, %s
  #  message_out_keys count, message
  #</match>
</label>
